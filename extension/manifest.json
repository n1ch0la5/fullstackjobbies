{
  "manifest_version": 3,
  "name": "Full Stack Jobbies: Job Sniffer",
  "short_name": "Jobbies",
  "version": "0.1.1",
  "description": "Rates job listings from Rocket ship 🚀 to Bloody mess ☠️ and flags red flags. Runs entirely in your browser; nothing is sent anywhere.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Rate a job",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.recruitee.com/*",
        "https://apply.workable.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*.js", "badge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
